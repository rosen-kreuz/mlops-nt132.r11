# Sao chép thành .env rồi điền giá trị:  cp .env.example .env
# File .env đã nằm trong .gitignore. Không commit .env.

# Kaggle API (mỗi người dùng key của mình)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Cổng (chỉ API mở ra ngoài; các cổng còn lại bind 127.0.0.1)
API_PORT=8000
MLFLOW_PORT=5000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Grafana: đổi mật khẩu mặc định admin/admin
GF_SECURITY_ADMIN_PASSWORD=change-me
